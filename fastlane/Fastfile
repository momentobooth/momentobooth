fastlane_require 'dotenv'

opt_out_usage

# Authenticate with an App Store Connect API key instead of an Apple ID, so that no
# interactive login is needed. Note that renewing a `developer_id` certificate is the
# one thing an API key cannot do — that needs an Account Holder login.
def load_app_store_connect_api_key
  app_store_connect_api_key(
    key_id: ENV['APP_STORE_CONNECT_KEY_ID'],
    issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
    key_content: ENV['APP_STORE_CONNECT_KEY'],
    is_key_content_base64: true,
    in_house: false
  )
end

desc "CI: install the Developer ID certificate and Direct profile using an App Store Connect API key"
lane :ci_install_release_cert_using_api do
  load_app_store_connect_api_key

  setup_ci
  match(type: "developer_id")
end

desc "Install the development certificate and profile into your login keychain, needed to run debug builds"
lane :install_dev_cert do
  load_app_store_connect_api_key

  match(type: "development", renew_expired_certs: true)
end

desc "Install the Developer ID certificate and profile into your login keychain, needed to make release builds"
lane :install_release_cert do
  load_app_store_connect_api_key

  match(type: "developer_id")
end
