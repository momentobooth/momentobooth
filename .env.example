# Certificate repository (fastlane match), see documentation/src/dev_setup.md
MATCH_CERTIFICATES_GIT_URL=git@github.com:momentobooth/certificates.git
MATCH_CERTIFICATES_GIT_FULL_NAME="My Full Name"
MATCH_CERTIFICATES_GIT_EMAIL=me@mydomain.com

# App Store Connect API key, used to talk to Apple without an interactive login
APP_STORE_CONNECT_KEY_ID=ABCD123456
APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000
APP_STORE_CONNECT_KEY=base64-of-the-AuthKey_ABCD123456.p8-file

# Apple ID, only needed to renew the Developer ID certificate (Account Holder account)
FASTLANE_USER=my.apple@dev.account
